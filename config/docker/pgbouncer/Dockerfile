FROM edoburu/pgbouncer:v1.24.1-p1

COPY pgbouncer.ini /etc/pgbouncer/pgbouncer.ini

# userlist.txt holds the pgbouncer_auth credential. The image runs as uid 70
# (postgres), so the file MUST be owned by that uid — otherwise PgBouncer logs
# "could not open auth_file ... Permission denied" and every connection fails
# with "password authentication failed for user pgbouncer_auth".
# Without --chown this silently depends on the build host's file mode: a 644
# checkout happens to work, a 600 file (e.g. generated by a deploy script)
# does not. --chown makes it correct either way and keeps the secret 600.
COPY --chown=70:70 userlist.txt /etc/pgbouncer/userlist.txt

HEALTHCHECK --interval=10s --timeout=5s --retries=5 \
    CMD pg_isready -h localhost -p 5432 -U pgbouncer_auth
