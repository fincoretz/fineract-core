# ── Database (via PgBouncer) ──────────────────────────────────────────────────
FINERACT_HIKARI_DRIVER_SOURCE_CLASS_NAME=org.postgresql.Driver
FINERACT_HIKARI_JDBC_URL=jdbc:postgresql://pgbouncer:5432/fineract_tenants
FINERACT_HIKARI_USERNAME=fineract
FINERACT_HIKARI_PASSWORD=password

# ── Tenant store ──────────────────────────────────────────────────────────────
FINERACT_DEFAULT_TENANTDB_HOSTNAME=pgbouncer
FINERACT_DEFAULT_TENANTDB_PORT=5432
FINERACT_DEFAULT_TENANTDB_UID=fineract
FINERACT_DEFAULT_TENANTDB_PWD=password
FINERACT_DEFAULT_TENANTDB_MASTER_PASSWORD=StrongMasterKey@2026

# ── Connection pool (small — PgBouncer handles multiplexing) ──────────────────
FINERACT_HIKARI_MINIMUM_IDLE=5
FINERACT_HIKARI_MAXIMUM_POOL_SIZE=20
FINERACT_HIKARI_CONNECTION_TIMEOUT=30000
FINERACT_HIKARI_IDLE_TIMEOUT=600000
FINERACT_HIKARI_LEAK_DETECTION_THRESHOLD=60000
FINERACT_CONFIG_MIN_POOL_SIZE=1
FINERACT_CONFIG_MAX_POOL_SIZE=5

# ── Server ────────────────────────────────────────────────────────────────────
FINERACT_SERVER_PORT=8080
FINERACT_SERVER_SSL_ENABLED=false
FINERACT_SERVER_TOMCAT_MAX_CONNECTIONS=8192
FINERACT_SERVER_TOMCAT_ACCEPT_COUNT=200

# ── JVM ───────────────────────────────────────────────────────────────────────
JAVA_OPTS=-Xms1g -Xmx2g -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+UseStringDeduplication

# ── Security ──────────────────────────────────────────────────────────────────
FINERACT_DEFAULT_MASTER_PASSWORD=StrongMasterKey@2026

# ── Kafka — batch job dispatch (batch-manager → batch-worker) ─────────────────
# Manager and worker are separate JVMs in this topology, so the in-process
# spring-events handler (the default) cannot carry jobs between them — Kafka
# must be explicit here or batch dispatch silently does nothing.
FINERACT_REMOTE_JOB_MESSAGE_HANDLER_SPRING_EVENTS_ENABLED=false
FINERACT_REMOTE_JOB_MESSAGE_HANDLER_KAFKA_ENABLED=true
FINERACT_REMOTE_JOB_MESSAGE_HANDLER_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
FINERACT_REMOTE_JOB_MESSAGE_HANDLER_KAFKA_TOPIC_NAME=job-topic

# ── Kafka — business events ─────────────────────────────────────────────────────
FINERACT_EXTERNAL_EVENTS_ENABLED=true
FINERACT_EXTERNAL_EVENTS_KAFKA_ENABLED=true
FINERACT_EXTERNAL_EVENTS_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
FINERACT_EXTERNAL_EVENTS_KAFKA_TOPIC_NAME=external-events
