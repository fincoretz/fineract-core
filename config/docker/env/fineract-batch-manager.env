FINERACT_MODE_READ_ENABLED=false
FINERACT_MODE_WRITE_ENABLED=false
FINERACT_MODE_BATCH_WORKER_ENABLED=false
FINERACT_MODE_BATCH_MANAGER_ENABLED=true
FINERACT_SERVER_TOMCAT_THREADS_MAX=50
FINERACT_SERVER_TOMCAT_THREADS_MIN_SPARE=5

# Batch-manager only schedules and dispatches (COB partitioning, event flush) —
# the heavy chunk processing happens on batch-worker — so its direct DB
# concurrency is low and a small pool is plenty. Trimmed from the shared 20.
FINERACT_HIKARI_MAXIMUM_POOL_SIZE=10
FINERACT_HIKARI_MINIMUM_IDLE=2
