FINERACT_MODE_READ_ENABLED=false
FINERACT_MODE_WRITE_ENABLED=false
FINERACT_MODE_BATCH_WORKER_ENABLED=true
FINERACT_MODE_BATCH_MANAGER_ENABLED=false
LOAN_COB_THREAD_POOL_CORE_POOL_SIZE=10
LOAN_COB_THREAD_POOL_MAX_POOL_SIZE=20
LOAN_COB_THREAD_POOL_QUEUE_CAPACITY=100

# Hikari pool must exceed the COB thread pool above: each COB worker thread
# holds a DB connection for the duration of its chunk transaction, so a pool
# sized == LOAN_COB_THREAD_POOL_MAX_POOL_SIZE (the previous shared default of
# 20) leaves nothing for the instance's other DB work (health checks, event
# decoding) and causes connection-timeout errors under COB load. Sized above it.
FINERACT_HIKARI_MAXIMUM_POOL_SIZE=30
FINERACT_HIKARI_MINIMUM_IDLE=10
