# LOCAL-ONLY tenant-provisioning config for the splitstack.
# Applied (via env_file) to the write and read Fineract roles only — write
# creates tenants, read serves the onboarding GET; the batch roles don't expose
# the provisioning API. These are the same throwaway local creds already
# committed in docker-compose-splitstack.yml's `db` service; do NOT reuse them
# anywhere real. On this local stack `default` doubles as the platform-admin
# tenant, so the internal API can be called with default's own super user
# (imara.admin). Production sets equivalents as real secrets, not from a file.
FINERACT_PLATFORM_ADMIN_TENANT_ID=default
FINERACT_TENANT_PROVISIONING_SUPERUSER_USERNAME=postgres
FINERACT_TENANT_PROVISIONING_SUPERUSER_PASSWORD=pgSuperLocal123
FINERACT_TENANT_PROVISIONING_SUPERUSER_JDBC_URL=jdbc:postgresql://fineract_db:5432/postgres
FINERACT_TENANT_PROVISIONING_PGBOUNCER_AUTH_PASSWORD=KsZt1PhATzftm7aiW2k30mnm!Xz9
FINERACT_TENANT_PROVISIONING_SELF_API_BASE_URL=http://fineract-write:8080/fineract-provider
