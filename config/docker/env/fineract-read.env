FINERACT_MODE_READ_ENABLED=true
FINERACT_MODE_WRITE_ENABLED=false
FINERACT_MODE_BATCH_WORKER_ENABLED=false
FINERACT_MODE_BATCH_MANAGER_ENABLED=false
FINERACT_SERVER_TOMCAT_THREADS_MAX=400
FINERACT_SERVER_TOMCAT_THREADS_MIN_SPARE=20

# Read instances serve high GET concurrency (Tomcat threads above). Because
# PgBouncer multiplexes the app-side pool onto only a few real PostgreSQL
# connections, a larger Hikari pool here costs Postgres nothing and lifts read
# throughput past the shared default of 20. Starting point — tune to load.
FINERACT_HIKARI_MAXIMUM_POOL_SIZE=30
